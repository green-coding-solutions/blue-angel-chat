# Model: use one your Claude plan includes, e.g. claude-opus-5-5 or claude-sonnet-5-5
MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, uses more of your limits)
EFFORT=medium
MAX_TURNS=40
HOST=127.0.0.1
PORT=8000

# Leave unset to use your local `claude` login (Pro/Max subscription, local personal use only).
# Set it to bill the Anthropic API instead (required if other people use the app).
# ANTHROPIC_API_KEY=sk-ant-...
